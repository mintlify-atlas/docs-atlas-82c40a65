  "keyFeatures": [
    "Structured curriculum from beginner to expert in AI agents",
    "Hands-on tutorials using smolagents, LangGraph, and LlamaIndex",
    "Free certification process with fundamentals and completion certificates",
    "Agentic RAG use case with real-world application",
    "Multi-agent systems and vision agent coverage",
    "Final project with GAIA benchmark evaluation and student leaderboard",
    "Bonus units covering fine-tuning, observability, and game agents",
    "Multilingual content (English, French, Spanish, Chinese, Korean, Russian, Vietnamese)"
  ],
  "publicApiSurface": [
    "smolagents - lightweight framework for building capable AI agents",
    "LlamaIndex - LLM-powered agents over data using indexes and workflows",
    "LangGraph - production-ready agent applications with flow control",
    "CodeAgent - agents that write and execute code actions",
    "ToolCallingAgent - agents using JSON blob tool calls",
    "MultiAgentSystem - orchestration of multiple agents",
    "RetrievalAgent - agents augmented with vector search",
    "AgenticRAG - retrieval augmented generation with agent reasoning",
    "GAIA benchmark - evaluation framework for final project assessment"
  ]
